    "overrides": {
      "title": "4. Per token overrides",
      "description": "Below the seed on purpose. Reach for one only when the seed is right and a single token must differ.",
      "costTitle": "What an override costs",
      "costDescription": "A token set by hand stops following the seed. The next brand change moves everything derived and leaves this value behind, and no audit reports it.",
      "labelTitle": "Label colour on the fill",
      "labelHelper": "By default the label is chosen by the seed's own luminance, the same 0.179 threshold a runtime re-theme uses. Forcing it is the one override the generator has a flag for.",
      "labelAuto": "Automatic",
      "labelLight": "Light label",
      "labelDark": "Dark label",
      "darkTitle": "Dark seed lightness",
