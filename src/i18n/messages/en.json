  "themeEditor": {
    "title": "Theme editor",
    "subtitle": "One seed colour in, a whole brand out, measured rather than asserted.",
    "unreadable": {
      "title": "The token stylesheet could not be read",
      "description": "This page derives a brand from the canvas colours and ramp steps the document is painting, read from the live stylesheet. Neither could be read here, so nothing below it would be a measurement."
    },
    "order": {
      "title": "Seed, then role, then scope, then instance",
      "description": "Stop at the first level that does the job. Every level below the seed is a value that has stopped deriving, and nothing tells you when the brand moves past it."
    },
    "seed": {
      "title": "1. Seed",
      "description": "The brand's action colour: what a primary button is filled with. In most cases this is the whole theme.",
      "label": "Brand seed",
      "helper": "A six digit hex. Everything below derives from it and is measured against WCAG 2.2 AA.",
      "presetLabel": "Edge cases",
      "presetHelper": "Each of these produces an answer a well behaved blue hides.",
      "presetPlaceholder": "A seed of your own",
      "preset": {
        "godx": "This package's own seed",
        "blue": "An ordinary brand blue",
        "very-light": "Near white: the fill cannot clear the light canvas",
        "very-dark": "Near black: the dark seed runs to white",
        "sunflower": "Sunflower: repoints the state steps in both themes"
      },
      "announce": {
        "one": "Seed {hex}. Light {light}, dark {dark}. {pass} of {count} measured pair clears AA.",
        "other": "Seed {hex}. Light {light}, dark {dark}. {pass} of {count} measured pairs clear AA."
      },
      "announceNoDark": "Seed {hex}. No lightness at this hue and saturation carries a readable fill on the dark canvas, so there is no dark theme to measure."
    },
    "derived": {
      "title": "2. What the seed produces",
      "description": "Read only, because these are results. Three roles per theme are written into the export; the rest derive from the primary in scope at the element that paints them, so writing them would pin them to this seed.",
      "tableLabel": "Roles derived from the seed",
      "column": {
        "token": "Token",
        "light": "Light",
        "dark": "Dark",
        "emitted": "In the export"
      },
      "written": "Written",
      "derivedOnly": "Derives"
    },
    "contrast": {
      "title": "3. Contrast",
