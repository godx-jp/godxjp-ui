{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godx.jp/schemas/frame-coverage.ledger.schema.json",
  "title": "Godx preview frame-coverage ledger (issue #163)",
  "description": "Machine-readable contract linking every public export and compound subcomponent to a frame, and declaring each contract dimension as covered / untested / not-applicable. UNTESTED IS NOT A PASS: the absence of a demonstrated state must never be read as support. Generated by scripts/gen-frame-coverage-ledger.mjs and enforced by scripts/check-frame-coverage-ledger.mjs.",
  "type": "object",
  "required": ["schemaVersion", "policy", "baseline", "cases", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "generatedBy": { "type": "string" },
    "readme": { "type": "array", "items": { "type": "string" } },
    "policy": {
      "type": "object",
      "required": [
        "issue",
        "standard",
        "verdicts",
        "viewports",
        "dimensions",
        "axes",
        "notApplicable",
        "knownGaps",
        "runtimeGates",
        "sweeps"
      ],
      "properties": {
        "issue": { "type": "string", "format": "uri" },
        "standard": { "type": "string" },
        "documentation": { "type": "string" },
        "verdicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/verdict" },
          "minItems": 3,
          "uniqueItems": true
        },
        "viewports": {
          "type": "object",
          "required": ["required", "containerWidths", "embeddable"],
          "properties": {
            "required": {
              "description": "Issue #163 §5. The gate refuses a ledger that drops any of these widths.",
              "type": "array",
              "minItems": 8,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 240 }
            },
            "containerWidths": {
              "description": "Container-width cases required in addition to the viewport matrix for embeddable exports.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 120 }
            },
            "note": { "type": "string" },
            "embeddable": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "dimensions": {
          "description": "The 14 contract dimensions of issue #163 item 2. Each carries the WRITTEN reason used when a cell is untested or auto not-applicable, so reasons are single-sourced instead of repeated per export.",
          "type": "array",
          "minItems": 14,
          "items": {
            "type": "object",
            "required": ["id", "title", "axis", "applicability", "promotion", "untestedReason"],
            "properties": {
              "id": { "$ref": "#/$defs/dimensionId" },
              "title": { "type": "string", "minLength": 1 },
              "axis": { "$ref": "#/$defs/axis" },
              "applicability": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["kind", "prop"],
                    "properties": {
                      "kind": { "const": "prop" },
                      "prop": { "type": "string", "minLength": 1 }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": ["kind", "props"],
                    "properties": {
                      "kind": { "const": "anyProp" },
                      "props": {
                        "type": "array",
                        "minItems": 1,
                        "items": { "type": "string", "minLength": 1 }
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": ["kind"],
                    "properties": { "kind": { "const": "universal" } },
                    "additionalProperties": false
                  }
                ]
              },
              "promotion": { "enum": ["prop-evidence", "declared-case"] },
              "untestedReason": { "type": "string", "minLength": 40 },
              "notApplicableReason": { "type": "string", "minLength": 40 }
            },
            "additionalProperties": false
          }
        },
        "axes": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/axis" }
        },
        "notApplicable": {
          "description": "Human waivers. A universally applicable dimension may only leave `untested` for `not-applicable` through a written, attributed, reviewed entry — never silently.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "dimension", "reason", "reviewedBy", "reviewedIn", "reviewedAt"],
            "properties": {
              "target": { "type": "string", "minLength": 1 },
              "dimension": { "$ref": "#/$defs/dimensionId" },
              "reason": { "type": "string", "minLength": 40 },
              "reviewedBy": { "type": "string", "minLength": 1 },
              "reviewedIn": { "type": "string", "pattern": "^https://" },
              "reviewedAt": { "type": "string", "format": "date-time" }
            },
            "additionalProperties": false
          }
        },
        "knownGaps": {
          "description": "Issue #163 'Initial known gaps to encode'. Locked in scripts/frame-coverage-contract.mjs: entries may be resolved, never deleted or waived.",
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": ["id", "targets", "dimensions", "cases", "source"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "targets": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "dimensions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/dimensionId" }
              },
              "cases": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "source": { "type": "string" },
              "resolvedBy": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        },
        "runtimeGates": {
          "description": "Scripts that surface frame RUNTIME errors (issue #163 item 4). The gate fails if one is deleted or unwired from package.json.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sweeps": {
          "type": "object",
          "required": ["geometry", "axe"],
          "properties": {
            "geometry": { "$ref": "#/$defs/sweep" },
            "axe": { "$ref": "#/$defs/sweep" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "infra": {
      "description": "Harness capabilities every /frame route provides. They make a dimension EXERCISABLE — they never make it exercised.",
      "type": "object"
    },
    "baseline": {
      "description": "The ratchet. Recorded rather than enforced-to-zero, because the pre-existing untested backlog is the honest state of issue #163. `covered` may only rise; `knownMissingFrames` and the sweep failure counts may only shrink.",
      "type": "object",
      "required": [
        "recordedAt",
        "note",
        "exports",
        "dimensionCells",
        "covered",
        "untested",
        "notApplicable",
        "knownMissingFrames",
        "geometryFailingCells",
        "axeFailingFrames"
      ],
      "properties": {
        "recordedAt": { "type": "string" },
        "note": { "type": "string" },
        "exports": { "type": "integer", "minimum": 1 },
        "dimensionCells": { "type": "integer", "minimum": 1 },
        "covered": { "type": "integer", "minimum": 0 },
        "untested": { "type": "integer", "minimum": 0 },
        "notApplicable": { "type": "integer", "minimum": 0 },
        "knownMissingFrames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "geometryFailingCells": { "type": "integer", "minimum": 0 },
        "axeFailingFrames": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "cases": {
      "description": "Hand-authored, reviewed frame cases — the ONLY route to `covered` for a behavioural dimension. Every field must resolve; a case that does not resolve cannot promote anything.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "export",
          "dimensions",
          "frame",
          "case",
          "evidence",
          "verifiedBy",
          "verifiedIn",
          "verifiedAt"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "export": { "type": "string", "minLength": 1 },
          "dimensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/dimensionId" }
          },
          "frame": {
            "description": "Repository-relative path of the docs frame source that renders the case.",
            "type": "string",
            "minLength": 1
          },
          "case": {
            "description": "The visible heading of the single case inside that frame which answers this contract question.",
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "description": "Repository-relative paths that must exist: the executed test, runtime-evidence script or capture proving the case ran.",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "viewports": {
            "description": "Required when the case promotes `responsive`: must list every width in policy.viewports.required.",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "integer" }
          },
          "containerWidths": {
            "description": "Required when the case promotes `responsive` for an embeddable export.",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "integer" }
          },
          "verifiedBy": { "type": "string", "minLength": 1 },
          "verifiedIn": { "type": "string", "pattern": "^https://" },
          "verifiedAt": { "type": "string", "format": "date-time" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "components": {
      "description": "Every public export and compound subcomponent discovered from the component barrels. Generated — a hand-edited verdict is rejected by the gate, which recomputes each cell from the evidence.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["group", "owner", "frames", "baseline", "dimensions"],
        "properties": {
          "group": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "frames": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "hasFrame": { "const": false },
          "embeddable": { "const": true },
          "baseline": {
            "type": "object",
            "required": ["covered", "notApplicable", "untested"],
            "properties": {
              "covered": { "type": "integer", "minimum": 0 },
              "notApplicable": { "type": "integer", "minimum": 0 },
              "untested": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "dimensions": {
            "type": "object",
            "minProperties": 14,
            "additionalProperties": { "$ref": "#/$defs/cell" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "verdict": { "enum": ["covered", "untested", "not-applicable"] },
    "axis": {
      "enum": [
        "visual",
        "state",
        "ownership",
        "contentStress",
        "responsive",
        "international",
        "accessibility",
        "preferences",
        "async"
      ]
    },
    "dimensionId": {
      "enum": [
        "variants",
        "tones",
        "sizes",
        "shapes",
        "density",
        "ownership",
        "states",
        "async",
        "responsive",
        "rtl",
        "contentStress",
        "keyboard",
        "accessibleName",
        "reducedMotion"
      ]
    },
    "cell": {
      "description": "untested | not-applicable:<api-manifest|reviewed> | covered:prop-evidence:<prop> | covered:declared-case:<caseId>[+<caseId>]",
      "type": "string",
      "pattern": "^(untested|not-applicable:(api-manifest|reviewed)|covered:(prop-evidence:[A-Za-z0-9_$]+|declared-case:[A-Za-z0-9_.+-]+))$"
    },
    "sweep": {
      "type": "object",
      "required": ["runner", "baseline", "note"],
      "properties": {
        "runner": { "type": "string" },
        "baseline": { "type": "string" },
        "recordedAt": { "type": ["string", "null"] },
        "widths": { "type": "array", "items": { "type": "integer" } },
        "failingFrames": { "type": "integer", "minimum": 0 },
        "failingCells": { "type": "integer", "minimum": 0 },
        "failingRules": { "type": "array", "items": { "type": "string" } },
        "byWidth": { "type": "object" },
        "note": { "type": "string", "minLength": 40 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
