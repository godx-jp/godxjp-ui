{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godx.jp/schemas/screen-reader-evidence.schema.json",
  "title": "Godx real screen-reader owner evidence",
  "type": "object",
  "required": ["$schema", "schemaVersion", "policy", "records"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 3 },
    "policy": {
      "type": "object",
      "required": [
        "issue",
        "requiredLocales",
        "combinations",
        "cohorts",
        "complexOwners",
        "notApplicable",
        "note"
      ],
      "properties": {
        "issue": { "type": "string", "format": "uri" },
        "requiredLocales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "combinations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "operatingSystem", "assistiveTechnology", "browser", "appliesTo"],
            "properties": {
              "id": { "type": "string" },
              "operatingSystem": { "type": "string" },
              "assistiveTechnology": { "type": "string" },
              "browser": { "type": "string" },
              "appliesTo": { "enum": ["all-interactive", "complex-composites-and-live-regions"] }
            },
            "additionalProperties": false
          }
        },
        "cohorts": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "required": ["id", "title", "requiredPhases", "owners"],
            "properties": {
              "id": {
                "enum": [
                  "landmarks-page-structure",
                  "native-form-controls",
                  "selection-composites",
                  "overlays",
                  "navigation-composites",
                  "data-structures",
                  "live-async-feedback"
                ]
              },
              "title": { "type": "string", "minLength": 1 },
              "requiredPhases": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/journeyPhase" }
              },
              "owners": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        },
        "complexOwners": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "notApplicable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "scope", "reason", "reviewedBy", "reviewedIn", "reviewedAt"],
            "properties": {
              "target": { "type": "string", "minLength": 1 },
              "scope": { "enum": ["owner", "export"] },
              "reason": { "type": "string", "minLength": 40 },
              "reviewedBy": { "type": "string", "minLength": 1 },
              "reviewedIn": { "type": "string", "format": "uri" },
              "reviewedAt": { "type": "string", "format": "date-time" }
            },
            "additionalProperties": false
          }
        },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "combinationId",
          "operatingSystem",
          "operatingSystemVersion",
          "assistiveTechnology",
          "assistiveTechnologyVersion",
          "browser",
          "browserVersion",
          "locale",
          "frameUrl",
          "entryCommand",
          "journey",
          "steps",
          "transcript",
          "captureMethod",
          "evidenceUrl",
          "testedAt",
          "tester",
          "verdict"
        ],
        "properties": {
          "id": { "type": "string" },
          "owner": { "type": "string" },
          "combinationId": { "type": "string" },
          "operatingSystem": { "type": "string" },
          "operatingSystemVersion": { "type": "string" },
          "assistiveTechnology": { "type": "string" },
          "assistiveTechnologyVersion": { "type": "string" },
          "browser": { "type": "string" },
          "browserVersion": { "type": "string" },
          "locale": { "type": "string" },
          "frameUrl": { "type": "string" },
          "entryCommand": { "type": "string", "minLength": 1 },
          "journey": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["phase", "command", "announced"],
              "properties": {
                "phase": { "$ref": "#/$defs/journeyPhase" },
                "command": { "type": "string", "minLength": 1 },
                "announced": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "transcript": { "type": "string" },
          "captureMethod": {
            "enum": [
              "audio-recording",
              "at-speech-log",
              "voiceover-last-phrase",
              "nvda-speech-viewer"
            ]
          },
          "evidenceUrl": { "type": "string" },
          "testedAt": { "type": "string", "format": "date-time" },
          "tester": { "type": "string" },
          "verdict": { "enum": ["pass", "fail"] },
          "defectUrl": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "journeyPhase": {
      "enum": [
        "landmark-navigation",
        "focus-entry",
        "internal-navigation",
        "activation",
        "value-change",
        "escape-close",
        "focus-return",
        "required-announcement",
        "help-announcement",
        "invalid-announcement",
        "error-announcement",
        "loading-announcement",
        "success-announcement",
        "recovery-announcement"
      ]
    }
  },
  "additionalProperties": false
}
