{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godx.jp/schemas/screen-reader-evidence.schema.json",
  "title": "Godx real screen-reader owner evidence",
  "type": "object",
  "required": ["$schema", "schemaVersion", "policy", "records"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "policy": {
      "type": "object",
      "required": ["issue", "requiredLocales", "combinations", "complexOwners", "note"],
      "properties": {
        "issue": { "type": "string", "format": "uri" },
        "requiredLocales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "combinations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "operatingSystem", "assistiveTechnology", "browser", "appliesTo"],
            "properties": {
              "id": { "type": "string" },
              "operatingSystem": { "type": "string" },
              "assistiveTechnology": { "type": "string" },
              "browser": { "type": "string" },
              "appliesTo": { "enum": ["all-interactive", "complex-composites-and-live-regions"] }
            },
            "additionalProperties": false
          }
        },
        "complexOwners": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "combinationId",
          "operatingSystem",
          "operatingSystemVersion",
          "assistiveTechnology",
          "assistiveTechnologyVersion",
          "browser",
          "browserVersion",
          "locale",
          "frameUrl",
          "journey",
          "transcript",
          "captureMethod",
          "evidenceUrl",
          "testedAt",
          "tester",
          "verdict"
        ],
        "properties": {
          "id": { "type": "string" },
          "owner": { "type": "string" },
          "combinationId": { "type": "string" },
          "operatingSystem": { "type": "string" },
          "operatingSystemVersion": { "type": "string" },
          "assistiveTechnology": { "type": "string" },
          "assistiveTechnologyVersion": { "type": "string" },
          "browser": { "type": "string" },
          "browserVersion": { "type": "string" },
          "locale": { "type": "string" },
          "frameUrl": { "type": "string" },
          "journey": { "type": "string" },
          "transcript": { "type": "string" },
          "captureMethod": {
            "enum": [
              "audio-recording",
              "at-speech-log",
              "voiceover-last-phrase",
              "nvda-speech-viewer"
            ]
          },
          "evidenceUrl": { "type": "string" },
          "testedAt": { "type": "string", "format": "date-time" },
          "tester": { "type": "string" },
          "verdict": { "enum": ["pass", "fail"] },
          "defectUrl": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
